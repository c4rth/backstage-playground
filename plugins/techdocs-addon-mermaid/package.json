{
  "name": "@internal/plugin-techdocs-addon-mermaid",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "techdocs",
    "pluginPackage": "@backstage/plugin-techdocs"
  },
  "keywords": [
    "backstage",
    "techdocs",
    "mermaid"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-techdocs-react": "backstage:^",
    "@backstage/theme": "backstage:^",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "4.0.0-alpha.61",
    "d3": "^7.9.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "mermaid": "^11.15.0",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/johanneswuerbach/backstage-plugin-techdocs-addon-mermaid",
    "directory": "."
  },
  "packageManager": "yarn@4.8.1"
}
